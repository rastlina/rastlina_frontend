{
  "functions": {
    "api/page.ts": { "includeFiles": "dist/{server-shell.html,article-data.json}", "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/contact", "destination": "/bulk", "permanent": true },
    { "source": "/terms", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/shipping", "destination": "/shipping-policy", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/returns", "destination": "/returns-refund-policy", "permanent": true },
    { "source": "/3d", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/optimized/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/:image(logo-optimized.webp|self-watering-banner-optimized.webp|og-image.webp)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/:page(login|profile|checkout)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/watch-shop/:slug",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    { "source": "/shop", "destination": "/seo-shop.html" },
    { "source": "/shop/:category", "destination": "/app.html" },
    { "source": "/about", "destination": "/seo-about.html" },
    { "source": "/product/:slug", "destination": "/api/page?kind=product&slug=:slug" },
    { "source": "/blog/:slug", "destination": "/api/page?kind=article&slug=:slug" },
    { "source": "/:page(login|profile|checkout)", "destination": "/app.html" },
    { "source": "/watch-shop/:slug", "destination": "/app.html" },
    { "source": "/bulk", "destination": "/seo-bulk.html" },
    { "source": "/privacy-policy", "destination": "/seo-privacy-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/seo-terms-and-conditions.html" },
    { "source": "/shipping-policy", "destination": "/seo-shipping-policy.html" },
    { "source": "/returns-refund-policy", "destination": "/seo-returns-refund-policy.html" },
    { "source": "/replacement-policy", "destination": "/seo-replacement-policy.html" },
    {
      "source": "/((?!api/|static/|media/).*)",
      "destination": "/api/page?kind=not-found"
    }
  ]
}
