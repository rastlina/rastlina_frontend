{
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/optimized/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/:image(logo-optimized.webp|self-watering-banner-optimized.webp|og-image.webp)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/:page(login|profile|checkout)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    { "source": "/shop", "destination": "/seo-shop.html" },
    { "source": "/bulk", "destination": "/seo-bulk.html" },
    { "source": "/privacy-policy", "destination": "/seo-privacy-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/seo-terms-and-conditions.html" },
    { "source": "/shipping-policy", "destination": "/seo-shipping-policy.html" },
    { "source": "/returns-refund-policy", "destination": "/seo-returns-refund-policy.html" },
    { "source": "/replacement-policy", "destination": "/seo-replacement-policy.html" },
    {
      "source": "/((?!api/|static/|media/).*)",
      "destination": "/app.html"
    }
  ]
}
